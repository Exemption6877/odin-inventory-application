<%- include("partials/navbar.ejs") %>
<main>
  <form class="entry-form" action="/newentry" method="POST">
    <label for="title">Title</label>
    <input
      type="text"
      name="title"
      id="title"
      value="<%= locals.editedEntry ? locals.editedEntry.title : '' %>"
    />
    <label for="imageurl">Image URL</label>
    <input
      type="text"
      name="imageurl"
      id="imageurl"
      value="<%= locals.editedEntry ? locals.editedEntry.cover_url : '' %>"
    />
    <label for="date">Pick a date:</label>
    <input
      type="date"
      id="date"
      name="date"
      value="<%= locals.editedEntry && locals.editedEntry.release_date
    ? new Date(locals.editedEntry.release_date).toISOString().split('T')[0]
    : '' %>"
    />
    <label for="platform">Platform</label>
    <select name="platform" id="platform">
      <%if (locals.editedEntry){%>
      <option selected value="<%=locals.editedEntry.platform_id %>">
        <%=locals.editedEntry.platform %>
      </option>
      <option value>None</option>

      <%} else {%>
      <option selected value>None</option>
      <% } %> <% locals.platforms.forEach(platform => { %> <% if
      (!locals.editedEntry || platform.id !== locals.editedEntry.platform_id) {
      %>
      <option value="<%= platform.id %>"><%= platform.name %></option>
      <% } %> <% }) %>
    </select>

    <label for="developer">Developer</label>
    <select name="developer" id="developer">
      <%if (locals.editedEntry){%>
      <option selected value="<%=locals.editedEntry.developer_id %>">
        <%=locals.editedEntry.developer %>
      </option>
      <option value>None</option>

      <%} else {%>
      <option selected value>None</option>
      <% } %> <% locals.developers.forEach(developer => { %> <% if
      (!locals.editedEntry || developer.id !== locals.editedEntry.developer_id)
      { %>
      <option value="<%= developer.id %>"><%= developer.name %></option>
      <% } %> <% }) %>
    </select>

    <label for="price">Price</label>
    <input
      type="number"
      name="price"
      id="price"
      value="<%= locals.editedEntry ? locals.editedEntry.price : '' %>"
    />
    <label for="discount">Discount</label>
    <input
      type="number"
      name="discount"
      id="discount"
      value="<%= locals.editedEntry ? locals.editedEntry.discount : '' %>"
    />
    <label for="available">Availability</label>
    <select name="available" id="available">
      <% if (locals.editedEntry) { %> <% if (locals.editedEntry.available) { %>
      <option value="true" selected>Available</option>
      <option value="false">Out of stock</option>
      <% } else { %>
      <option value="true">Available</option>
      <option value="false" selected>Out of stock</option>
      <% } %> <% } else { %>
      <option value="true">Available</option>
      <option value="false">Out of stock</option>
      <% } %>
    </select>

    <label for="categories1">Category 1</label>
    <select id="categories1" name="categories1">
      <%if (locals.editedEntry){%>
      <option selected value="<%=locals.editedEntry.categories_id[0] %>">
        <%=locals.editedEntry.categories[0] %>
      </option>
      <option value>None</option>
      <% } else { %>
      <option selected value>None</option>

      <% } %> <% locals.categories.forEach(category => { %> <% if
      (!locals.editedEntry || category.id !==
      locals.editedEntry.categories_id[0]) { %>
      <option value="<%= category.id %>"><%= category.name %></option>
      <% }}) %>
    </select>

    <label for="categories2">Category 2</label>
    <select id="categories2" name="categories2">
      <%if (locals.editedEntry){%>
      <option selected value="<%=locals.editedEntry.categories_id[1] %>">
        <%=locals.editedEntry.categories[1] %>
      </option>
      <option value>None</option>
      <% } else { %>
      <option selected value>None</option>

      <% } %> <% locals.categories.forEach(category => { %> <% if
      (!locals.editedEntry || category.id !==
      locals.editedEntry.categories_id[1]) { %>
      <option value="<%= category.id %>"><%= category.name %></option>
      <% }}) %>
    </select>

    <input type="submit" value="Submit" />
  </form>
</main>
<%- include("partials/footer.ejs") %>
