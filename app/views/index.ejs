<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="stylesheet" href="/styles/reset.css" />
    <link rel="stylesheet" href="/styles/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Game Shop</title>
  </head>
  <body>
    <%- include("partials/navbar.ejs") %>
    <main>
      <h1>Game Shop Index</h1>

      <% if (locals.items && locals.items.length > 0) { %> <%
      locals.items.forEach(item => { %>
      <div class="item">
        <img src="<%= item.cover_url %>" alt="<%= item.title %> cover" />
        <h4><%= item.title %></h4>
        <p><%= item.price %></p>
        <p><%= item.available ? 'Available' : 'Out of stock' %></p>
        <ul>
          <% item.categories.forEach(entry => { %>
          <li><%= entry %></li>
          <% }) %>
        </ul>
        <p><%= item.developer %></p>
      </div>
      <% }) %> <% } else { %>
      <p>No games found.</p>
      <% } %>
    </main>
    <%- include("partials/footer.ejs") %>
  </body>
</html>
